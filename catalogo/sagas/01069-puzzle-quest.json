        },
        {
          "field": "summary",
          "value": "Puzzle Quest: Galactrix, or Galactrix, is a puzzle video game developed by Infinite Interactive for the PC, Nintendo DS, Xbox 360's Xbox Live Arcade, and PlayStation 3's PlayStation Network service.\n\nThe game offers a full-featured campaign mode, online multiplayer for 2 to 4 players, and downloadable content, including ships, items, plans, planets, factions and missions.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "Puzzle Quest: Galactrix, o simplemente Galactrix, es un videojuego de puzles desarrollado por Infinite Interactive para PC, Nintendo DS, Xbox Live Arcade de Xbox 360 y el servicio PlayStation Network de PlayStation 3.\n\nEl juego ofrece una campaña completa, modo multijugador en línea para 2 a 4 jugadores y contenido descargable, que incluye naves, objetos, planos, planetas, facciones y misiones.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "2009",
          "source": "igdb",
          "manual": false
        }
