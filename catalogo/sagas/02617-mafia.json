    {
      "id": 3609,
      "kind": "story",
      "rationale": "La saga tiene historias independientes con distinto protagonista, pero se pueden ordenar por época: Sicilia de 1904, los años 30, los 40-50 y 1968.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 43824,
          "recommendedVersionId": 103656,
          "reason": "Ocurre en 1904, en Sicilia, y es el más antiguo de la cronología. Solo existe en una versión."
        },
        {
          "position": 2,
          "gameId": 32476,
          "recommendedVersionId": 81501,
          "reason": "Transcurre entre 1930 y 1938. Se recomienda el remake, que reconstruye el original con mejores gráficos y jugabilidad."
        },
        {
          "position": 3,
          "gameId": 11562,
          "recommendedVersionId": 28008,
          "reason": "Cubre de 1943 a 1951. Se recomienda la Edición Definitiva por su mejor aspecto y sus mejoras técnicas."
        },
        {
          "position": 4,
          "gameId": 41767,
          "recommendedVersionId": 99473,
          "reason": "Sucede en 1968 y cierra la cronología. Solo existe en una versión."
        }
      ]
    },
    {
      "id": 3610,
      "kind": "community",
      "rationale": "Se recomienda jugar en orden de lanzamiento usando los remakes. Mafia III va al final porque es el más divisivo en jugabilidad, aunque su historia es muy valorada.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 32476,
          "recommendedVersionId": 81501,
          "reason": "Es el mejor punto de entrada. El remake es la forma recomendada de jugarlo hoy, por encima del original de 2002."
        },
        {
          "position": 2,
          "gameId": 11562,
          "recommendedVersionId": 28008,
          "reason": "Continúa el estilo narrativo de la saga. La remasterización mejora la imagen y reúne los DLC."
        },
        {
          "position": 3,
          "gameId": 43824,
