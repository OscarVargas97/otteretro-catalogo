        {
          "field": "summary",
          "value": "The Walking Dead: Season One (also known as The Walking Dead: The Game) is an episodic interactive drama graphic adventure video game developed and published by Telltale Games. Based on Robert Kirkman's The Walking Dead comic book series, the game consists of five episodes, released between April and November 2012. It is available for Android, iOS, Kindle Fire HDX, Microsoft Windows, Mac OS X, PlayStation 3, PlayStation Vita, Xbox 360, PlayStation 4 and Xbox One. The game is the first of The Walking Dead video game series published by Telltale.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "The Walking Dead: Season One (también conocido como The Walking Dead: The Game) es un videojuego de aventura gráfica interactiva y drama episódico desarrollado y publicado por Telltale Games. Basado en la serie de cómics de Robert Kirkman The Walking Dead, el juego consta de cinco episodios, lanzados entre abril y noviembre de 2012. Está disponible para Android, iOS, Kindle Fire HDX, Microsoft Windows, Mac OS X, PlayStation 3, PlayStation Vita, Xbox 360, PlayStation 4 y Xbox One. Es el primer juego de la serie de videojuegos The Walking Dead publicada por Telltale.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "2012",
          "source": "igdb",
          "manual": false
        }
      ],
