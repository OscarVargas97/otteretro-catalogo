    {
      "id": 3577,
      "kind": "story",
      "rationale": "La serie de Telltale es una historia continua (Clementine) en cuatro temporadas. Los demás juegos son spin-offs o adaptaciones sin continuidad con ella.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8541,
          "recommendedVersionId": 16811,
          "reason": "Temporada 1: inicio de la historia de Clementine. Versión de PC por su facilidad de acceso."
        },
        {
          "position": 2,
          "gameId": 8621,
          "recommendedVersionId": 17144,
          "reason": "Temporada 2: continúa directamente con Clementine."
        },
        {
          "position": 3,
          "gameId": 9167,
          "recommendedVersionId": 19405,
          "reason": "A New Frontier: sigue la historia con nuevos protagonistas y Clementine."
        },
        {
          "position": 4,
          "gameId": 10509,
          "recommendedVersionId": 24170,
          "reason": "Temporada final: cierra el arco de Clementine."
        }
      ]
    },
    {
      "id": 3578,
      "kind": "community",
      "rationale": "La comunidad recomienda las cuatro temporadas de Telltale en orden de lanzamiento. Se omiten Assault, Survival Instinct, Onslaught, Destinies y Streets of Survival por ser spin-offs de menor calidad o sin relación con la historia.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8541,
          "recommendedVersionId": 16811,
          "reason": "Es el punto de partida y el mejor valorado. Versión de PC por estabilidad."
        },
        {
          "position": 2,
          "gameId": 8621,
          "recommendedVersionId": 17144,
          "reason": "Continuación directa, muy elogiada."
        },
        {
          "position": 3,
          "gameId": 9167,
          "recommendedVersionId": 19405,
          "reason": "Más irregular, pero necesaria para entender la temporada final."
        },
