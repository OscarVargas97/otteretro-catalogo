      "id": 5829,
      "nameEs": "Battle Dodgeball: Toukyuu Daigekitotsu!",
      "originalName": "Battle Dodgeball: Toukyuu Daigekitotsu!",
      "year": 1991,
      "igdbId": 49148,
      "popularity": 0,
