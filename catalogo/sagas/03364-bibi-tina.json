    {
      "id": 20880,
      "nameEs": "Bibi & Tina: Das grosse Reiterfest",
      "originalName": "Bibi & Tina: Das grosse Reiterfest",
      "year": 2011,
      "igdbId": 268112,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
          "field": "name_es",
