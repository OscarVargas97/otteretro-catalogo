          "position": 1,
          "gameId": 41780,
          "recommendedVersionId": 99615,
          "reason": "Es el inicio de la historia. Se recomienda el remaster de PS5 por mejoras visuales y de rendimiento."
        },
        {
          "position": 2,
          "gameId": 42998,
          "recommendedVersionId": 102251,
          "reason": "Continúa directamente la historia de Aloy. La versión de PS5 es la más pulida."
        }
      ]
    },
    {
      "id": 3630,
      "kind": "community",
      "rationale": "Se juegan en orden de lanzamiento, porque Forbidden West depende del primero. LEGO Horizon Adventures se deja para el final, o se omite, porque es un spin-off ligero de cooperativo.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 41780,
          "recommendedVersionId": 99615,
          "reason": "Punto de partida obligado. El remaster mejora gráficos y rendimiento respecto al original."
        },
        {
          "position": 2,
          "gameId": 42998,
          "recommendedVersionId": 102251,
          "reason": "Secuela directa. La versión de PS5 (o la de PC si no tienes consola) es la recomendada frente a PS4."
        },
        {
          "position": 3,
          "gameId": 30447,
          "recommendedVersionId": 76020,
          "reason": "Opcional y ligero, pensado para jugar en cooperativo. Mejor después de conocer la historia principal por sus guiños."
        }
      ]
