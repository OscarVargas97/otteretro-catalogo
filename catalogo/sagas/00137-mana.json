    {
      "id": 3163,
      "nameEs": "Heroes of Mana",
      "originalName": "Heroes of Mana",
      "year": 2007,
      "igdbId": 14990,
      "popularity": 7,
      "iconic": false,
      "fields": [
        {
          "field": "name_es",
