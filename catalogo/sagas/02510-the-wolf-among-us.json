    {
      "id": 3647,
      "kind": "story",
      "rationale": "La secuela transcurre después del primer juego (el primero es una precuela de los cómics Fables), así que el orden de la historia coincide con el de lanzamiento.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 39802,
          "reason": "Es el inicio de la historia y es necesario para entender la secuela. La versión da igual; la remasterizada mejora lo visual."
        },
        {
          "position": 2,
          "gameId": 10655,
          "reason": "Continúa directamente los eventos del primero. Aún no sale, así que no hay versión recomendada."
        }
      ]
    },
    {
      "id": 3648,
      "kind": "community",
      "rationale": "Se juega el primero y luego la secuela, que continúa su trama. Según lo que sé, la comunidad prefiere la versión remasterizada del primero. No pude verificarlo en la web.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 39802,
          "recommendedVersionId": 93466,
          "reason": "La versión remasterizada de PC es la que suele recomendarse hoy por su mejor aspecto y soporte actual. No lo pude confirmar con fuentes."
        },
        {
          "position": 2,
          "gameId": 10655,
