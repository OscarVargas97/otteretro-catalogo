    {
      "id": 3623,
      "kind": "story",
      "rationale": "La saga sigue la historia continua de Senua, así que el orden de la historia coincide con el de lanzamiento. Senua (2027) aún no ha salido y su lugar en la cronología no está confirmado, por eso la dejo fuera.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8814,
          "reason": "Es el origen de la historia de Senua y es necesario para entender la secuela. Todas las versiones son el mismo juego, así que da igual cuál elijas."
        },
        {
          "position": 2,
          "gameId": 43460,
          "reason": "Continúa directamente el viaje de Senua tras el primer juego. Elige la versión según tu plataforma."
        }
      ]
    },
    {
      "id": 3624,
      "kind": "community",
      "rationale": "Se recomienda jugar en orden de lanzamiento: el primer juego es corto y la secuela depende de él. Senua (2027) queda fuera por no haber salido. Esta ruta no tiene fuentes web porque no pude consultarlas, así que sale de mi conocimiento previo.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8814,
          "recommendedVersionId": 17928,
          "reason": "Es imprescindible antes de la secuela. Recomiendo la versión de PC, que es la más completa en gráficos y rendimiento, aunque cualquier versión sirve."
        },
        {
          "position": 2,
          "gameId": 43460,
          "recommendedVersionId": 103004,
          "reason": "Es la continuación directa y tiene una presentación visual muy cuidada. Recomiendo la versión de PC por rendimiento, aunque las de consola también valen."
        }
      ]
    }
