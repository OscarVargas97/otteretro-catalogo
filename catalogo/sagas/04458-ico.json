    {
      "id": 3655,
      "kind": "story",
      "rationale": "Shadow of the Colossus es una precuela de Ico según su director, así que cronológicamente va primero. Ico ocurre después.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 32555,
          "recommendedVersionId": 81490,
          "reason": "Es el inicio de la cronología. Se recomienda el remake de PS4 por sus gráficos y controles modernos."
        },
        {
          "position": 2,
          "gameId": 32799,
          "recommendedVersionId": 82727,
          "reason": "Sucede después de Shadow of the Colossus. El remaster de PS3 mejora la imagen y el rendimiento respecto al original de PS2."
        }
      ]
    },
    {
      "id": 3656,
      "kind": "community",
      "rationale": "La comunidad suele recomendar el orden de lanzamiento, Ico y luego Shadow of the Colossus, porque así se ve la evolución del diseño. Las dos son cortas y también se pueden jugar en el orden contrario.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 32799,
          "recommendedVersionId": 82727,
          "reason": "Es el primer juego y presenta el estilo de la saga. Se recomienda el remaster de PS3 por su mejor rendimiento y resolución. El original de PS2 también es válido."
        },
        {
          "position": 2,
          "gameId": 32555,
          "recommendedVersionId": 81490,
          "reason": "Es la continuación espiritual y, cronológicamente, una precuela. Se recomienda el remake de PS4 por ser la versión más pulida y accesible."
        }
      ]
    }
  ]
