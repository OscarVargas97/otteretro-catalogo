          "criteria": [
            {
              "criterion": "content",
              "value": "3",
              "text": "Es un juego distinto y más corto, de acción con estructura más simple."
            },
            {
              "criterion": "gameplay",
              "value": "3",
              "text": "Controles algo más directos y portátil, pero repetitivo y con poca profundidad."
            },
            {
              "criterion": "original",
              "value": "3",
              "text": "Adapta la historia de forma libre, como juego diferente y no como port."
            },
            {
              "criterion": "technical",
              "value": "3",
              "text": "Pantalla monocromática de Game Boy, con buena legibilidad pero poco detalle."
