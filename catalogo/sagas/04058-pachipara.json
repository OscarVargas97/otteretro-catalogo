    {
      "id": 34890,
      "nameEs": "PachiPara12: Daikai to Natsu no Omoide",
      "originalName": "PachiPara12: Daikai to Natsu no Omoide",
      "year": 2005,
      "igdbId": 256625,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
          "field": "name_es",
          "value": "PachiPara12: Daikai to Natsu no Omoide",
