    {
      "id": 90,
      "kind": "community",
      "rationale": "Se recomienda empezar por Temtem, que presenta el mundo y las mecánicas, y probar Swarm después si te gusta la saga. Sin fuentes verificadas.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 11535,
          "reason": "Es la experiencia principal y la mejor entrada a la saga. No hay remaster ni remake, así que sirve cualquier versión."
        },
        {
          "position": 2,
          "gameId": 47105,
          "reason": "Es opcional y funciona como extra. No requiere haber jugado el primero, pero se disfruta más conociendo a los Temtem."
