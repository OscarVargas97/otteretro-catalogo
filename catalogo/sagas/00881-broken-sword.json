    {
      "id": 8616,
      "nameEs": "Broken Sword 5: La Maldición de la Serpiente",
      "originalName": "Broken Sword 5: The Serpent's Curse",
      "year": 2013,
      "igdbId": 2924,
      "popularity": 94,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "17125",
