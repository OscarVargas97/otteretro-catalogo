    {
      "id": 25180,
      "nameEs": "PoPoLoCrois Monogatari II",
      "originalName": "PoPoLoCrois Monogatari II",
      "year": 2000,
      "igdbId": 63016,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
