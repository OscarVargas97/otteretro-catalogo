    {
      "id": 39666,
      "nameEs": "DmC: Devil May Cry",
      "originalName": "DmC: Devil May Cry",
      "year": 2013,
      "igdbId": 1254,
      "popularity": 514,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "94813",
          "source": "script",
          "manual": false
        },
        {
          "field": "name_es",
          "value": "DmC: Devil May Cry",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "original_name",
          "value": "DmC: Devil May Cry",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary",
          "value": "DmC: Devil May Cry is the fifth game in the hack-and-slash third-person action series and the first not largely developed by Capcom. This title is a reimagining of the series, with the same protagonist Dante, but set in an alternate universe. The Dante in this game is very different from before, doing away with the trademark white hair and altering the main character as well as the game's tone with a much more Western influence. The gameplay is still largely identical as Dante engages many opponents with a fast fighting style, stringing together combos and hits in quick succession.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "DmC: Devil May Cry es la quinta entrega de la serie de acción en tercera persona de hack-and-slash y la primera que no fue desarrollada en gran parte por Capcom. Este título es una reimaginación de la serie, con el mismo protagonista, Dante, pero ambientada en un universo alternativo. El Dante de este juego es muy distinto al de antes: no tiene el característico pelo blanco y cambia tanto al protagonista como el tono del juego, con una influencia occidental mucho más marcada. La jugabilidad sigue siendo en gran medida la misma, ya que Dante enfrenta a muchos oponentes con un estilo de combate rápido, encadenando combos y golpes en sucesión veloz.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "2013",
          "source": "igdb",
          "manual": false
        }
      ],
