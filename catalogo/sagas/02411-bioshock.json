    {
      "id": 3625,
      "kind": "story",
      "rationale": "Por fecha interna, Infinite ocurre en 1912, antes de Rapture (1960 y 1968). Pero la saga no tiene una historia continua: solo comparte universo y algunos temas, así que el orden cronológico no cambia la experiencia.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 39673,
          "recommendedVersionId": 94665,
          "reason": "Su historia transcurre en 1912, la fecha más temprana. Versión original de PC, sin remaster."
        },
        {
          "position": 2,
          "gameId": 39492,
          "recommendedVersionId": 22355,
          "reason": "Rapture en 1960. El remaster mejora la imagen y trae el contenido extra."
        },
        {
          "position": 3,
          "gameId": 39562,
          "recommendedVersionId": 22359,
          "reason": "Continúa en Rapture en 1968. El remaster incluye Minerva's Den."
        }
      ]
    },
    {
      "id": 3626,
      "kind": "community",
      "rationale": "Se recomienda jugar en orden de lanzamiento: Infinite se disfruta más sabiendo de BioShock, y las historias son casi independientes. BioShock 2 es opcional; se juega por el contexto de Rapture.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 39492,
          "recommendedVersionId": 22355,
          "reason": "Es el punto de partida y el más valorado de la saga. Se recomienda el remaster por la mejora visual y la compatibilidad actual."
        },
        {
          "position": 2,
          "gameId": 39562,
          "recommendedVersionId": 22359,
          "reason": "Complementa la historia de Rapture. Se recomienda el remaster por la calidad técnica y porque incluye Minerva's Den."
        },
        {
          "position": 3,
          "gameId": 39673,
          "recommendedVersionId": 94665,
          "reason": "Cierra la saga con una historia que pide conocer los juegos anteriores. No tiene remaster, así que va el original en PC."
        }
      ]
    }
