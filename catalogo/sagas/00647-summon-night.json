    {
      "id": 35444,
      "nameEs": "Summon Night 5",
      "originalName": "Summon Night 5",
      "year": 2013,
      "igdbId": 13110,
      "popularity": 2,
      "iconic": false,
      "fields": [
        {
          "field": "name_es",
          "value": "Summon Night 5",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "original_name",
          "value": "Summon Night 5",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary",
          "value": "Summon Night 5 is a tactical role-playing game in the Summon Night series of games. The game involves the player moving characters in a turn based fashion across a large grid from an adjustable isometric perspective. At the beginning of the game, the player can chose to play as either a male or female protagonist, and chose from 4 separate \"Cross\" (partner) characters. Which combinations are selected affect both the dialogue and story progression, leading to eight separate paths to take through the game. The world of Summon Night changed dramatically for this entry. Now the medieval setting changed completely to a more contemporary world mixed with many of the other cultures and tribes already present in other Summon Night games. The stage for this title is the city of Savorle, a model city in this new era where people from all the different world can coexist.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "Summon Night 5 es un juego de rol táctico de la serie Summon Night. El jugador mueve a los personajes por turnos a través de una gran cuadrícula, desde una perspectiva isométrica ajustable. Al comienzo del juego, el jugador puede elegir jugar como protagonista masculino o femenino, y escoger entre 4 personajes compañeros «Cross» distintos. Las combinaciones seleccionadas afectan tanto a los diálogos como al desarrollo de la historia, lo que da lugar a ocho caminos distintos a lo largo del juego. El mundo de Summon Night cambia de forma radical en esta entrega. El entorno medieval se transforma por completo en un mundo más contemporáneo, mezclado con muchas de las culturas y tribus que ya aparecían en otros juegos de Summon Night. El escenario de este título es la ciudad de Savorle, una ciudad modelo de esta nueva era donde personas de los distintos mundos pueden convivir.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "2013",
          "source": "igdb",
          "manual": false
        }
      ],
