      "id": 34357,
      "nameEs": "Sanyo Pachinko Paradise 7: Edokko Gen-san",
      "originalName": "Sanyo Pachinko Paradise 7: Edokko Gen-san",
      "year": 2002,
      "igdbId": 138539,
      "popularity": 0,
