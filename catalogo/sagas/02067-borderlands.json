    {
      "id": 3579,
      "kind": "story",
      "rationale": "Cronología interna: The Pre-Sequel ocurre entre el 1 y el 2, y Tales from the Borderlands tras el 2. New Tales y el 4 siguen al 3. Wonderlands y su one-shot son un spin-off aparte y se omiten.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8504,
          "recommendedVersionId": 18208,
          "reason": "Inicio de la saga. Versión remasterizada de PC."
        },
        {
          "position": 2,
          "gameId": 8676,
          "recommendedVersionId": 17355,
          "reason": "Cuenta cómo Jack llega al poder, antes del 2."
        },
        {
          "position": 3,
          "gameId": 8554,
          "recommendedVersionId": 16870,
          "reason": "Secuela principal, con Jack como villano."
        },
        {
          "position": 4,
