        {
          "field": "summary",
          "value": "Virtua Fighter 2 is a fighting video game developed by Sega. It is the sequel to Virtua Fighter (1993) and the second game in the Virtua Fighter series. It was created by Sega's Yu Suzuki-headed AM2 and was released for arcades in 1994. Ports were later released for various platforms.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "Virtua Fighter 2 es un videojuego de lucha desarrollado por Sega. Es la secuela de Virtua Fighter (1993) y el segundo juego de la serie Virtua Fighter. Fue creado por AM2, el estudio de Sega dirigido por Yu Suzuki, y se lanzó para máquinas recreativas en 1994. Posteriormente se publicaron versiones para diversas plataformas.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "1994",
          "source": "igdb",
          "manual": false
        }
