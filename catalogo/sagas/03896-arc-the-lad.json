    {
      "id": 33250,
      "nameEs": "Arc the Lad: Twilight of the Spirits",
      "originalName": "Arc the Lad: Twilight of the Spirits",
      "year": 2003,
      "igdbId": 21558,
      "popularity": 13,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
