      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8701,
          "reason": "Se recomienda jugarlo en su edición definitiva, que añade zonas y habilidades. Los dos juegos son cortos."
        },
        {
          "position": 2,
