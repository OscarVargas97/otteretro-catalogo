        {
          "field": "summary",
          "value": "Based on the Russian novel Metro 2033 by Dmitry Glukhovsky, Metro: Last Light is a post-apocalyptic horror first-person shooter that serves as a new chapter in the Metro saga and is the sequel to Metro 2033. Like its predecessor, the game is a primarily story-driven shooter with heavy stealth elements. Artyom may carry up to three weapons at a time, however bullets are scarce and valuable to the point that higher grade bullets are, in fact, the Metro's currency. When dealing with armed opponents, stealth is encouraged and it is wise to save ammunition for the many mutant creatures encountered in combat. In many situations the player can choose between straightforward shooting and stealth, also having the option for lethal or non-lethal enemy takedowns.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "year",
          "value": "2013",
          "source": "igdb",
          "manual": false
        }
