    {
      "id": 3993,
      "kind": "story",
      "rationale": "System Shock ocurre en 2072 y System Shock 2 unos 40 años después, con SHODAN como hilo común. La cronología coincide con el orden de lanzamiento.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 9291,
          "recommendedVersionId": 19916,
          "reason": "Cuenta el origen de SHODAN; el remake de 2023 es la forma moderna de jugarlo."
        },
        {
          "position": 2,
          "gameId": 42935,
          "recommendedVersionId": 40757,
          "reason": "Continuación directa en lo temático; el remaster de PC (Enhanced Edition) corre mejor en sistemas actuales."
        }
      ]
    },
    {
      "id": 3994,
      "kind": "community",
      "rationale": "System Shock 2 se entiende sin el primero, y muchos lo recomiendan como punto de entrada. El remake de System Shock es la opción accesible si quieres el contexto completo.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 9291,
          "recommendedVersionId": 19916,
          "reason": "El remake moderniza controles e interfaz, así que se puede jugar sin sufrir el original de 1994."
        },
        {
          "position": 2,
          "gameId": 42935,
          "recommendedVersionId": 40757,
          "reason": "Se considera el mejor de la saga; el remaster de PC arregla problemas de compatibilidad. Si prefieres empezar por él, puedes hacerlo."
        }
      ]
    }
