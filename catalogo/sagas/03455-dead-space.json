    {
      "id": 3603,
      "kind": "story",
      "rationale": "Cronología interna: Extraction transcurre antes y durante el inicio del primer juego, e Ignition queda entre el 1 y el 2. Es de memoria, sin fuentes consultadas.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 19482,
          "recommendedVersionId": 48505,
          "reason": "Precuela sobre el hallazgo del Marker en Aegis VII. La versión de PS3 es en HD y admite PlayStation Move."
        },
        {
          "position": 2,
          "gameId": 39522,
          "recommendedVersionId": 94866,
          "reason": "Historia principal de Isaac en la USG Ishimura. Se recomienda el remake por gráficos y calidad de vida."
        },
        {
          "position": 3,
          "gameId": 40179,
          "reason": "Prólogo de Dead Space 2, ambientado en Titan Station. Es un juego menor y ambas versiones son iguales."
        },
        {
          "position": 4,
          "gameId": 39591,
          "recommendedVersionId": 94430,
          "reason": "Continúa la historia de Isaac en The Sprawl. La versión de PC es la más estable y la más fácil de jugar hoy."
        },
        {
          "position": 5,
          "gameId": 39668,
          "recommendedVersionId": 94651,
          "reason": "Cierre de la trilogía en Tau Volantis. La versión de PC es la más estable y la más fácil de jugar hoy."
        }
      ]
    },
    {
      "id": 3604,
      "kind": "community",
      "rationale": "Se empieza por el remake del primero y se sigue con la trilogía principal. Se omite Ignition (juego menor) y Extraction queda como opcional al final. Falta contrastar con fuentes.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 39522,
          "recommendedVersionId": 94866,
          "reason": "Punto de entrada recomendado. El remake de 2023 mejora lo visual y lo jugable sin cambiar la historia."
        },
        {
          "position": 2,
          "gameId": 39591,
          "recommendedVersionId": 94430,
          "reason": "Considerado a menudo el mejor de la saga. En PC se juega bien y no hay remake."
        },
        {
          "position": 3,
          "gameId": 39668,
          "recommendedVersionId": 94651,
          "reason": "Cierra la historia de Isaac. Es mejor jugarlo en solitario o con cooperativo opcional."
        },
