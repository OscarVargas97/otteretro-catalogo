    {
      "id": 32909,
      "nameEs": "Trivial Pursuit: Trepidante",
      "originalName": "Trivial Pursuit: Unhinged",
      "year": 2004,
      "igdbId": 6216,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "82229",
          "source": "script",
          "manual": false
        },
        {
          "field": "name_es",
          "value": "Trivial Pursuit: Trepidante",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "original_name",
          "value": "Trivial Pursuit: Unhinged",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary",
          "value": "A popular trivia game is about to become a wild free-for-all. With incredible new game features, this all-new version of the Trivial Pursuit game rewards the clever, the speedy, and the sneaky, while still highlighting everybody's trivia talents. Trivia fans can bet against others, steal wedges and even crush rivals' game pieces (along with their hopes of winning). Add in some impressive Hollywood types hosting each category, and loads of multimedia clips, and you've got a Trivial Pursuit party where everybody is in on the action. For those who crave free-for-all play, the traditional game, or even a quick trivia fix, there are plenty of modes: the Unhinged version, the original classic, and a fast new minigame.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "Un popular juego de preguntas y respuestas está a punto de convertirse en un salvaje sálvese quien pueda. Con nuevas y increíbles funciones, esta versión totalmente nueva de Trivial Pursuit recompensa a los listos, a los rápidos y a los astutos, sin dejar de destacar los conocimientos de todos. Los aficionados a las preguntas pueden apostar contra los demás, robar quesitos e incluso aplastar las fichas de los rivales (junto con sus esperanzas de ganar). Añade a algunos famosos de Hollywood como presentadores de cada categoría y muchos clips multimedia, y tendrás una fiesta de Trivial Pursuit en la que todos participan. Para quienes buscan un todos contra todos, el modo tradicional o un repaso rápido de preguntas, hay muchos modos: la versión Unhinged, el clásico original y un nuevo minijuego rápido.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "2004",
          "source": "igdb",
          "manual": false
        }
