    {
      "id": 3639,
      "kind": "story",
      "rationale": "La historia es continua: Silksong ocurre después de Hollow Knight, así que el orden cronológico coincide con el de lanzamiento.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 7847,
          "reason": "Es el primer capítulo y presenta Hallownest y a Hornet. Solo hay versiones originales, así que da igual la plataforma."
        },
        {
          "position": 2,
          "gameId": 12609,
          "reason": "Continúa la historia con Hornet como protagonista en Pharloom. Todas las versiones son originales y equivalentes."
        }
      ]
    },
    {
      "id": 3640,
      "kind": "community",
      "rationale": "La recomendación habitual es jugar primero Hollow Knight: Silksong se entiende por sí solo, pero se disfruta más con el contexto y la experiencia previa. Esta ruta no está respaldada por fuentes consultadas.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 7847,
          "reason": "Sirve de base para el mundo, los personajes y el estilo de juego. No hay remasters, así que da igual la versión."
        },
        {
          "position": 2,
          "gameId": 12609,
          "reason": "Se juega después, con el contexto de Hollow Knight y más práctica en combate y exploración. Cualquier versión sirve."
        }
      ]
    }
