        },
        {
          "field": "summary",
          "value": "Pixeline i Pixieland is a Danish adventure game for PC where players join Pixeline on a colorful, child-friendly journey through imaginative locations. The game focuses on exploration, simple puzzles, and narrative interactions designed for younger audiences, featuring hand-drawn visuals and accessible gameplay that encourages curiosity and discovery.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "Pixeline i Pixieland es un juego de aventuras danés para PC en el que los jugadores acompañan a Pixeline en un viaje colorido y apto para niños por lugares imaginativos. El juego se centra en la exploración, en puzles sencillos y en interacciones narrativas pensadas para un público infantil, con gráficos dibujados a mano y una jugabilidad accesible que fomenta la curiosidad y el descubrimiento.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "2006",
          "source": "igdb",
          "manual": false
        }
