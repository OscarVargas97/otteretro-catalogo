    {
      "id": 6893,
      "nameEs": "R-Type II",
      "originalName": "R-Type II",
      "year": 1989,
      "igdbId": 6854,
      "popularity": 18,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "65433",
          "source": "claude",
          "manual": false
        },
        {
          "field": "name_es",
