    {
      "id": 34164,
      "nameEs": "AFL Premiership 2005",
      "originalName": "AFL Premiership 2005",
      "year": 2005,
      "igdbId": 73847,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
