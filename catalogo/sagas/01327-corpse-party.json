    {
      "id": 35184,
      "nameEs": "Corpse Party: The Anthology - Sachiko's Game of Love: Hysteric Birthday 2U",
      "originalName": "Corpse Party: The Anthology - Sachiko's Game of Love: Hysteric Birthday 2U",
      "year": 2012,
      "igdbId": 11608,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
          "field": "name_es",
          "value": "Corpse Party: The Anthology - Sachiko's Game of Love: Hysteric Birthday 2U",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "original_name",
          "value": "Corpse Party: The Anthology - Sachiko's Game of Love: Hysteric Birthday 2U",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary",
          "value": "Corpse Party: The Anthology - Sachiko's Game of Love: Hysteric Birthday 2U is a romantic comedy spin-off of the Corpse Party survival horror adventure game series. It features multiple stories written by various guests writers with supervision from Makoto Kedouin, the creator of the Corpse Party series. This game continues with a visual novel approach, as used previously in Corpse Party: Book of Shadows, where players are given various options and choices throughout each chapter. As in the previous games, there are a variety of bad endings that one can reach by selecting the wrong options. However, unlike most visual novels and the previous games in the series, this time the player will be in control of the actions of multiple characters in the same chapter.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "Corpse Party: The Anthology - Sachiko's Game of Love: Hysteric Birthday 2U es un spin-off de comedia romántica de la serie de juegos de aventura y terror de supervivencia Corpse Party. Incluye varias historias escritas por distintos autores invitados, bajo la supervisión de Makoto Kedouin, creador de la serie Corpse Party. El juego continúa con el enfoque de novela visual que se usó anteriormente en Corpse Party: Book of Shadows, en el que los jugadores tienen diversas opciones y decisiones a lo largo de cada capítulo. Como en los juegos anteriores, hay una variedad de finales malos a los que se puede llegar eligiendo las opciones equivocadas. Sin embargo, a diferencia de la mayoría de las novelas visuales y de los juegos anteriores de la serie, esta vez el jugador controla las acciones de varios personajes dentro del mismo capítulo.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "2012",
          "source": "igdb",
          "manual": false
        }
      ],
