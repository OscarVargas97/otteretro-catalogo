    {
      "id": 20396,
      "nameEs": "Chuck E. Cheese's Super Collection",
      "originalName": "Chuck E. Cheese's Super Collection",
      "year": 2011,
      "igdbId": 51044,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
