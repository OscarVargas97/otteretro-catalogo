    {
      "id": 3619,
      "kind": "story",
      "rationale": "La saga comparte universo (ctOS y Blume) y los juegos se suceden en orden de lanzamiento: Watch Dogs, Watch Dogs 2 y Legion. No hay una cronología distinta, así que se repite el orden de lanzamiento. Las historias son bastante independientes.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 7787,
          "recommendedVersionId": 14518,
          "reason": "Inicia la historia de Aiden Pearce y presenta ctOS. Se recomienda la versión de PC por rendimiento y mods."
        },
        {
          "position": 2,
          "gameId": 41928,
          "recommendedVersionId": 99928,
          "reason": "Sigue en el mismo universo con Marcus y DedSec en San Francisco. Se recomienda PC por rendimiento."
        },
        {
          "position": 3,
          "gameId": 42603,
          "recommendedVersionId": 101681,
          "reason": "Cierra la línea temporal con DedSec en Londres tras un Brexit ficticio. Se recomienda PC."
        }
      ]
    },
    {
      "id": 3620,
      "kind": "community",
      "rationale": "Muchos jugadores recomiendan empezar por Watch Dogs 2, el mejor valorado y con historia autónoma. Después vienen el primero, si interesa su tono más serio, y Legion. No se omite ningún juego. Esta ruta no está respaldada por fuentes consultadas.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 41928,
          "recommendedVersionId": 99928,
          "reason": "Es el más querido y no exige conocer el primero. Se recomienda PC o la versión más estable de tu consola."
        },
        {
          "position": 2,
          "gameId": 7787,
          "recommendedVersionId": 14518,
          "reason": "Es opcional y aporta contexto y el origen de ctOS. Se recomienda PC o consola actual, no las de generación anterior."
        },
        {
          "position": 3,
          "gameId": 42603,
          "recommendedVersionId": 101681,
          "reason": "Es el más reciente y funciona solo, aunque la comunidad lo valora menos. Se recomienda PC o consola actual."
        }
      ]
    }
