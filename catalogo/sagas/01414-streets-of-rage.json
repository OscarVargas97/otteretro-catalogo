    {
      "id": 3953,
      "kind": "story",
      "rationale": "La saga cuenta una historia continua contra el Sindicato y el Sr. X, así que el orden de la historia coincide con el de lanzamiento.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 4431,
          "reason": "Inicio de la historia: Axel, Blaze y Adam frenan al Sr. X. Da igual la versión."
        },
        {
          "position": 2,
          "gameId": 4853,
          "reason": "Continúa un año después con el regreso del Sindicato."
        },
        {
          "position": 3,
          "gameId": 19350,
          "reason": "Tercera entrega, con el Dr. Zan y el plan de los robots."
        },
        {
          "position": 4,
          "gameId": 12063,
          "reason": "Secuela moderna ambientada años después. Da igual la versión."
        }
      ]
    },
    {
      "id": 3954,
      "kind": "community",
      "rationale": "Se suele recomendar empezar por la 2, la mejor de la era clásica, seguir con la 3 y terminar con la 4. El primero queda como opcional, por ser más tosco.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 4853,
          "reason": "Se considera el mejor beat 'em up clásico y funciona como primera entrada sin conocer la 1."
        },
        {
          "position": 2,
          "gameId": 19350,
          "reason": "Más rápido y con más movimientos. Se recomienda la versión japonesa (Bare Knuckle III), que tiene mejor dificultad e historia, pero no pude confirmar cuál de las tres versiones es."
        },
        {
          "position": 3,
          "gameId": 12063,
          "reason": "Cierre moderno con homenajes a los juegos clásicos. Da igual la plataforma."
        },
        {
          "position": 4,
          "gameId": 4431,
          "reason": "Opcional: es el más básico, pero completa la historia."
        }
      ]
    }
