    {
      "id": 71,
      "kind": "story",
      "rationale": "No hay una historia continua: cada juego ocurre en un reino distinto y los vínculos son lore sutil. Se repite el orden de lanzamiento.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8527,
          "recommendedVersionId": 18198,
          "reason": "Introduce el ciclo del fuego y es la base del lore."
        },
        {
          "position": 2,
          "gameId": 11570,
          "recommendedVersionId": 27996,
          "reason": "Historia casi independiente, en Drangleic."
        },
        {
          "position": 3,
          "gameId": 11583,
          "recommendedVersionId": 27747,
          "reason": "Retoma y cierra temas del primero."
        }
      ]
    },
    {
      "id": 72,
      "kind": "community",
      "rationale": "La comunidad suele recomendar el orden de lanzamiento. Dark Souls II es el más polémico, pero se considera valioso. No se omite ningún juego. Sin fuentes verificadas.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8527,
          "recommendedVersionId": 18198,
          "reason": "Punto de partida clásico. El remaster es la versión más estable."
        },
        {
          "position": 2,
          "gameId": 11570,
          "recommendedVersionId": 27996,
          "reason": "Se recomienda la edición Scholar of the First Sin, con contenido y mejoras. Verificar que este id sea esa edición."
        },
        {
          "position": 3,
          "gameId": 11583,
          "recommendedVersionId": 27747,
          "reason": "Es el más pulido y el cierre natural. Muchos lo recomiendan también como primer juego."
        }
      ]
    }
