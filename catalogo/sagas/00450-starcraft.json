    {
      "id": 3606,
      "kind": "community",
      "rationale": "Se recomienda empezar por StarCraft Remastered (incluye Brood War) para entender la trama y luego jugar SC2 en orden. Quien prefiera algo más moderno puede empezar en Wings of Liberty.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 1104,
          "recommendedVersionId": 102322,
          "reason": "Remastered es la versión recomendada: gráficos actualizados, mismo juego y requisitos bajos. Las versiones N64 y original de PC no se aconsejan hoy."
        },
        {
          "position": 2,
          "gameId": 42968,
          "recommendedVersionId": 102168,
          "reason": "La campaña más accesible de SC2 y la que mejor introduce el conflicto."
        },
        {
          "position": 3,
          "gameId": 42977,
          "recommendedVersionId": 102183,
          "reason": "Continúa la historia de Kerrigan y es mejor jugarla antes del cierre."
        },
        {
          "position": 4,
          "gameId": 43415,
          "recommendedVersionId": 102856,
          "reason": "Final de la trilogía; la mayor parte de su peso narrativo depende de los juegos anteriores."
        }
      ]
