    {
      "id": 4255,
      "nameEs": "Phoenix Wright: Ace Attorney - Dual Destinies",
      "originalName": "Phoenix Wright: Ace Attorney - Dual Destinies",
      "year": 2013,
      "igdbId": 1432,
      "popularity": 96,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "9012",
          "source": "script",
          "manual": false
        },
        {
          "field": "name_es",
          "value": "Phoenix Wright: Ace Attorney - Dual Destinies",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "original_name",
          "value": "Phoenix Wright: Ace Attorney - Dual Destinies",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary",
          "value": "Dual Destinies continues the style of gameplay from previous installments, in which the player must utilize evidence and find contradictions in witness statements to prove their client innocent. Like previous installments, gameplay is split up between Investigations, in which players find evidence and question witnesses, and Trials, where they must use the evidence to expose contradictions. The game now features full 3D graphics and character models, allowing more dynamic camera angles during gameplay, such as quickly panning around the courtroom in the moments before a dramatic reveal. The 3D camera also allows investigation sequences to take place in 3D spaces, permitting greater investigative depth, such as being able to rotate around a room to look for clues.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "Dual Destinies mantiene el estilo de juego de las entregas anteriores, en el que el jugador debe usar pruebas y encontrar contradicciones en los testimonios de los testigos para demostrar la inocencia de su cliente. Como en las entregas anteriores, el juego se divide en Investigaciones, donde los jugadores encuentran pruebas e interrogan a testigos, y Juicios, donde deben usar las pruebas para exponer contradicciones. El juego ahora presenta gráficos y modelos de personajes en 3D completos, lo que permite ángulos de cámara más dinámicos durante la partida, como un barrido rápido de la sala del tribunal en los momentos previos a una revelación dramática. La cámara 3D también permite que las secuencias de investigación se desarrollen en espacios tridimensionales, lo que aporta mayor profundidad investigativa, como la posibilidad de girar alrededor de una habitación para buscar pistas.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "2013",
          "source": "igdb",
          "manual": false
        }
      ],
