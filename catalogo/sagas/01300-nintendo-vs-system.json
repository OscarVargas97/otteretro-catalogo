          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary",
          "value": "Vs. Golf is a golf game developed for the VS. Arcade Systems. It is an 18 hole golf game where the player chooses stroke play or match play against a human or computer player. This game was released in two editions, a Men's Golf and Ladies Golf edition featuring male and female characters.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "summary_es",
          "value": "Vs. Golf es un juego de golf desarrollado para los sistemas arcade VS. Consta de 18 hoyos, y el jugador elige entre juego por golpes o juego por hoyos contra otro jugador humano o la computadora. Se lanzó en dos ediciones: una de golf masculino y otra de golf femenino, con personajes hombres y mujeres, respectivamente.",
          "source": "claude",
          "manual": false
        },
        {
          "field": "year",
          "value": "1984",
          "source": "igdb",
          "manual": false
        }
      ],
      "versions": [],
      "images": {
        "cover": "https://images.igdb.com/igdb/image/upload/t_cover_big_2x/co7rdj.jpg"
      }
    },
    {
      "id": 50254,
      "nameEs": "Vs. Baseball",
      "originalName": "Vs. Baseball",
      "year": 1984,
      "igdbId": 40515,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
