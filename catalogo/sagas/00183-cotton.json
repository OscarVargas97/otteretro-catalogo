    {
      "id": 21399,
      "nameEs": "Cotton Boomerang",
      "originalName": "Cotton Boomerang",
      "year": 1998,
      "igdbId": 39830,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "54231",
