    {
      "id": 26783,
      "nameEs": "Montezuma's Revenge featuring Panama Joe",
      "originalName": "Montezuma's Revenge featuring Panama Joe",
      "year": 1984,
      "igdbId": 12297,
      "popularity": 17,
      "iconic": false,
      "fields": [
        {
          "field": "name_es",
