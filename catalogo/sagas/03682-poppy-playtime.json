    {
      "id": 30914,
      "nameEs": "Poppy Playtime: Chapter 4 - Safe Haven",
      "originalName": "Poppy Playtime: Chapter 4 - Safe Haven",
      "year": 2025,
      "igdbId": 318284,
      "popularity": 21,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "77225",
          "source": "script",
          "manual": false
        },
        {
          "field": "name_es",
