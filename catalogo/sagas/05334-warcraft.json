    {
      "id": 3613,
      "kind": "story",
      "rationale": "La historia sigue de la Primera Guerra a Azeroth y la Plaga hasta el MMO. Hearthstone es un juego de cartas sin lugar propio en la cronología y se deja fuera.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 43337,
          "recommendedVersionId": 103096,
          "reason": "Abre la historia con la invasión orca de Azeroth. Se recomienda el remaster por ser más cómodo de jugar hoy."
        },
        {
          "position": 2,
          "gameId": 42946,
          "recommendedVersionId": 102330,
          "reason": "Cuenta la Tercera Guerra: la Plaga, la Legión y la fundación de Theramore. Se recomienda la versión remake por ser la que sigue activa y actualizada."
        },
        {
          "position": 3,
          "gameId": 42953,
          "reason": "Continúa la historia tras Warcraft III. La versión da igual para empezar, porque el servidor actual unifica la experiencia."
        }
      ]
    },
    {
      "id": 3614,
      "kind": "community",
      "rationale": "Se suele empezar por Warcraft III, que cuenta lo esencial del lore y es la mejor puerta de entrada, y seguir con World of Warcraft. Se omiten Orcs & Humans, por antiguo, y Hearthstone, por ser un spin-off de cartas. No pude consultar la web en esta sesión, así que esta ruta se basa en mi conocimiento general y no cito fuentes.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 42946,
          "recommendedVersionId": 102330,
          "reason": "Es el mejor punto de partida: su campaña explica el lore que usa WoW. Se recomienda el remake por ser la versión mantenida; el original también sirve."
        },
        {
          "position": 2,
          "gameId": 42953,
          "reason": "Es la continuación directa y el centro de la saga. La versión da igual."
        }
      ]
    }
