      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 12198,
          "reason": "Es el juego base. Las versiones son equivalentes, así que da igual cuál elegir."
        },
        {
          "position": 2,
          "gameId": 39154,
          "reason": "Spin-off posterior (2027). No continúa ninguna historia, solo amplía el universo."
        }
      ]
    },
    {
      "id": 3996,
      "kind": "community",
      "rationale": "La comunidad recomienda jugar solo Among Us. On Guard es un spin-off de 2027 y no hay consenso sobre él, así que se deja fuera.",
