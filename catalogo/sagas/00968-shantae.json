    {
      "id": 4317,
      "nameEs": "Shantae and the Pirate's Curse",
      "originalName": "Shantae and the Pirate's Curse",
      "year": 2014,
      "igdbId": 8430,
      "popularity": 108,
      "iconic": false,
      "fields": [
