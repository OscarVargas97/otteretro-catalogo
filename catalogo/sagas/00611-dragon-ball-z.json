    {
      "id": 59,
      "kind": "story",
      "rationale": "Los juegos son adaptaciones o spin-offs sin una historia continua entre sí; se repite el orden de lanzamiento.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 1566,
          "recommendedVersionId": 3156,
          "reason": "Adapta las primeras sagas de Dragon Ball Z."
        },
        {
          "position": 2,
          "gameId": 16727,
          "reason": "Repasa la historia de Z con otro enfoque; versión indiferente."
        },
        {
          "position": 3,
          "gameId": 11634,
          "reason": "Recorre toda la historia con episodios y escenarios alternativos; versión indiferente."
        },
        {
          "position": 4,
          "gameId": 30958,
          "reason": "Juego independiente, sin continuidad con los anteriores; versión indiferente."
        }
      ]
    },
    {
      "id": 60,
      "kind": "community",
      "rationale": "Dejo fuera los juegos antiguos de baja calidad y me quedo con el más completo y actual. Sin fuentes verificadas.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 11634,
          "recommendedVersionId": 27924,
          "reason": "Es el juego más completo y mejor valorado de la lista, con gran plantel y modo historia. Recomiendo PS5 por rendimiento; PC o Xbox Series también valen."
        },
        {
          "position": 2,
          "gameId": 30958,
          "reason": "Opcional, para quien quiera más después de Sparking! Zero; versión indiferente."
