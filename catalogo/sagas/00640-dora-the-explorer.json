    {
      "id": 19163,
      "nameEs": "Go, Diego, Go! Great Dinosaur Rescue",
      "originalName": "Go, Diego, Go! Great Dinosaur Rescue",
      "year": 2008,
      "igdbId": 47978,
      "popularity": 0,
      "iconic": false,
      "fields": [
