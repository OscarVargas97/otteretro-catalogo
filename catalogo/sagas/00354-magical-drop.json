    {
      "id": 11129,
      "nameEs": "Magical Drop II",
      "originalName": "Magical Drop II",
      "year": 1996,
      "igdbId": 39348,
      "popularity": 11,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "27556",
          "source": "claude",
          "manual": false
        },
        {
          "field": "name_es",
