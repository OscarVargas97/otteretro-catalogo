    {
      "id": 14340,
      "nameEs": "Mary Skelter Finale",
      "originalName": "Mary Skelter Finale",
      "year": 2020,
      "igdbId": 131974,
      "popularity": 1,
      "iconic": false,
      "fields": [
        {
