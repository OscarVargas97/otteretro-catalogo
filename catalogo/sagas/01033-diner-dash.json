        },
        {
          "field": "summary",
          "value": "Welcome to Diner Dash, the action-puzzle that brings out the entrepreneur in all of us! Poor Flo! Sick and tired of pushing paper in the dreary, bleary-eyed world of finance, she ditched her desk job and now she's rolling up her sleeves and setting out to build her very own empire of high-class, five-star restaurants. It won't be easy, though! Flo's on her own now, and heading for the top! To get there she'll have to start on the ground floor—and she needs your help to survive and thrive. Diner Dash blends the best in fast paced-action puzzles with a build-your-restaurant-empire theme that encourages players to serve their way from a two-table diner to the top of the restaurant ladder – starting with a run-of-the-mill greasy spoon and ending in a dream restaurant.",
          "source": "igdb",
          "manual": false
        },
        {
          "field": "year",
          "value": "2007",
          "source": "igdb",
          "manual": false
        }
