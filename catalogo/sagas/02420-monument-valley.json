      "year": 2014,
      "igdbId": 8900,
      "popularity": 234,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "57157",
          "source": "claude",
          "manual": false
        },
        {
          "field": "name_es",
          "value": "Monument Valley",
          "source": "igdb",
