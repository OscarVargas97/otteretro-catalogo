    {
      "id": 25775,
      "nameEs": "King's Field: Pilot Style",
      "originalName": "King's Field: Pilot Style",
      "year": 1996,
      "igdbId": 129857,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
          "field": "name_es",
