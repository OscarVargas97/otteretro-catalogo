    {
      "id": 35316,
      "nameEs": "Buzz!: Master Quiz",
      "originalName": "Buzz!: Master Quiz",
      "year": 2008,
      "igdbId": 21944,
      "popularity": 2,
      "iconic": false,
      "fields": [
