      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 7689,
          "recommendedVersionId": 14819,
          "reason": "Es el inicio cronológico (2027). Se recomienda el Director's Cut en PC, que mejora los jefes e integra The Missing Link."
        },
        {
          "position": 2,
          "gameId": 39991,
          "recommendedVersionId": 95610,
          "reason": "Transcurre entre dos tramos de Human Revolution. Va aquí si juegas la versión original; el Director's Cut ya lo incluye. Versión de PC."
        },
