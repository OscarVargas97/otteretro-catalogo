    {
      "id": 24095,
      "nameEs": "The Chessmaster 3-D",
      "originalName": "The Chessmaster 3-D",
      "year": 1996,
      "igdbId": 15879,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
