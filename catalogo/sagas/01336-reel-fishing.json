      "nameEs": "Reel Fishing: Angler's Dream",
      "originalName": "Reel Fishing: Angler's Dream",
      "year": 2009,
      "igdbId": 5121,
      "popularity": 0,
      "iconic": false,
      "fields": [
        {
          "field": "name_es",
