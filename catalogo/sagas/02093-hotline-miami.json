    {
      "id": 3641,
      "kind": "story",
      "rationale": "La historia es continua, pero Hotline Miami 2 mezcla escenas anteriores y posteriores al primero (1985–1992). Se recomienda jugar el 1 primero para entender sus giros; el orden coincide con el de lanzamiento.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8562,
          "recommendedVersionId": 16907,
          "reason": "Introduce a Jacket y el tono de la historia; la versión de PC es la de referencia."
        },
        {
          "position": 2,
          "gameId": 8700,
          "recommendedVersionId": 17467,
          "reason": "Amplía y cruza la cronología del primero con varios protagonistas; mejor tras conocer el original. Versión de PC."
        }
      ]
    },
    {
      "id": 3642,
      "kind": "community",
      "rationale": "La comunidad recomienda jugar ambos en orden de lanzamiento: el segundo da por sabido el primero y su final pierde impacto si se juega antes.",
      "sources": "[]",
      "approved": true,
      "steps": [
        {
          "position": 1,
          "gameId": 8562,
          "recommendedVersionId": 16907,
          "reason": "Punto de partida obligado; la versión de PC es la original y la más completa en mods y controles con ratón."
        },
        {
          "position": 2,
          "gameId": 8700,
          "recommendedVersionId": 17467,
          "reason": "Continuación directa y cierre de la historia; también en PC por la precisión de apuntado con ratón."
        }
      ]
    }
