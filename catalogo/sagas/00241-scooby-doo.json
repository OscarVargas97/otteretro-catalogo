    {
      "id": 2874,
      "nameEs": "Scooby-Doo and the Cyber Chase",
      "originalName": "Scooby-Doo and the Cyber Chase",
      "year": 2001,
      "igdbId": 2859,
      "popularity": 22,
      "iconic": false,
      "fields": [
        {
          "field": "best_version",
          "value": "5856",
          "source": "script",
          "manual": false
        },
        {
          "field": "name_es",
          "value": "Scooby-Doo and the Cyber Chase",
          "source": "igdb",
