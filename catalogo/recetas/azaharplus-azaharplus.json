{
  "id": "azaharplus-azaharplus",
  "name": "Azahar (AzaharPlus)",
  "kind": "emulator",
  "folder": "Nintendo 3DS",
  "detect": "azahar.exe",
  "version": {
    "from": "date"
  },
  "consoles": [
    "3ds"
  ],
  "license": "GPL-2.0-or-later",
  "portable": [
    {
      "type": "folder",
      "path": "user"
    }
  ],
  "saves": [
    "user/sdmc"
  ],
  "config": [
    "user/config"
  ],
  "perGame": {
    "mods": [
      "user/load/mods/{titleId}",
      "user/load/textures/{titleId}"
    ]
  },
  "install": [
    {
      "formats": [
        "cia"
      ],
      "args": [
        "--install",
        "{file}"
      ]
    }
  ],
  "updates": {
    "source": "github",
    "repo": "AzaharPlus/AzaharPlus"
  },
  "asset": "^azaharplus-[0-9.]+-A-windows\\.zip$",
  "experimental": true,
  "forkOf": "azahar"
}
