{
  "id": "mohawku-bit-vita3k-enhanced-unofficial",
  "name": "Vita3K (mohawku-bit)",
  "kind": "emulator",
  "folder": "PS Vita",
  "detect": "Vita3K-Enhanced-R28.exe",
  "version": {
    "from": "date"
  },
  "consoles": [
    "vita"
  ],
  "license": "GPL-2.0-only",
  "devOnly": true,
  "portable": [
    {
      "type": "folder",
      "path": "portable"
    }
  ],
  "config": [
    "portable/config.yml"
  ],
  "install": [
    {
      "formats": [
        "pkg"
      ],
      "args": [
        "--pkg",
        "{file}",
        "--zrif",
        "{zrif}"
      ]
    },
    {
      "formats": [
        "pup"
      ],
      "args": [
        "--firmware",
        "{file}"
      ]
    }
  ],
  "options": [
    {
      "name": "renderer",
      "file": "portable/config.yml",
      "format": "yml",
      "key": "backend-renderer"
    },
    {
      "name": "resolution",
      "file": "portable/config.yml",
      "format": "yml",
      "key": "resolution-multiplier"
    },
    {
      "name": "filter",
      "file": "portable/config.yml",
      "format": "yml",
      "key": "screen-filter"
    },
    {
      "name": "vsync",
      "file": "portable/config.yml",
      "format": "yml",
      "key": "v-sync"
    },
    {
      "name": "anisotropy",
      "file": "portable/config.yml",
      "format": "yml",
      "key": "anisotropic-filtering"
    }
  ],
  "updates": {
    "source": "github",
    "repo": "mohawku-bit/Vita3K-Enhanced-Unofficial"
  },
  "asset": "^Vita3K-Enhanced-Preview117-R28-Windows-x64\\.zip$",
  "experimental": true,
  "forkOf": "vita3k"
}
