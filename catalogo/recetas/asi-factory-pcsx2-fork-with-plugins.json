{
  "id": "asi-factory-pcsx2-fork-with-plugins",
  "name": "PCSX2 (ASI-Factory)",
  "kind": "emulator",
  "folder": "PlayStation 2",
  "detect": "pcsx2-qtx64-avx2-clang.exe",
  "version": {
    "from": "date"
  },
  "consoles": [
    "ps2"
  ],
  "license": "GPL-3.0-only",
  "portable": [
    {
      "type": "file",
      "path": "portable.txt",
      "system": "windows"
    }
  ],
  "saves": [
    "memcards"
  ],
  "config": [
    "gamesettings",
    "inputprofiles"
  ],
  "perGame": {
    "config": "gamesettings/{serial}_{crc}.ini",
    "apply": "file",
    "mods": [
      "patches/{serial}_{crc}.pnach"
    ]
  },
  "updates": {
    "source": "github",
    "repo": "ASI-Factory/PCSX2-Fork-With-Plugins"
  },
  "asset": "^PCSX2Fork-Windows-x64-Clang-AVX2\\.zip$",
  "experimental": true,
  "forkOf": "pcsx2"
}
